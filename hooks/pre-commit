#!/bin/sh
# Nortropic innovation-intake — approved-plan contract gate.
#
# Refuses a commit that would put an unprovable lifecycle state into git history:
# a brief at planned/building/verified with no valid, hash-bound approved plan.
#
# Install (git does not track .git/hooks, so this is a per-clone step):
#     chmod +x hooks/pre-commit
#     ln -sf ../../hooks/pre-commit .git/hooks/pre-commit
#
# Bypass is `git commit --no-verify` and is the owner's explicit choice, not a default.

PC="$HOME/.claude/skills/nortropic-intake/scripts/plan_contract.py"
CORPUS="$(git rev-parse --show-toplevel)"

if [ ! -f "$PC" ]; then
    echo "pre-commit: nortropic-intake skill not found at $PC — skipping the" >&2
    echo "            approved-plan contract check. Install the skill to enable it." >&2
    exit 0
fi

CC="$HOME/.claude/skills/nortropic-intake/scripts/context_contract.py"
rc=0
python3 "$PC" --corpus "$CORPUS" validate || rc=1
echo
python3 "$CC" --corpus "$CORPUS" validate || rc=1

if [ "$rc" -ne 0 ]; then
    cat >&2 <<'MSG'

pre-commit REFUSED: the intake contract is not satisfied.

`status: planned | building | verified` requires a durable, owner-approved plan bound to
the brief by sha256; `building`/`verified` additionally require execution evidence.
Source manifests must hash-match their sources and carry no credentials; owner
clarifications are append-only and may not dangle.

Fix the findings above, or move the brief back to `status: clarified`. Never fabricate a
plan, a source or an owner answer to make this pass.

MSG
    exit 1
fi
